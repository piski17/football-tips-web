# Skopíruj tento súbor na ".env" a doplň skutočné hodnoty (lokálne spustenie).
# Na Render.com (alebo inom hostingu) sa tieto premenné nastavujú v nastaveniach
# služby (Environment Variables), tento súbor sa tam nenahráva.

API_FOOTBALL_KEY=tvoj_kluc_z_dashboard.api-football.com

# Voliteľné, ale odporúčané: bez toho sa uložené tipy vymažú pri každom
# redeployi/reštarte appky na Renderi (bezplatný plán má dočasný disk).
# Založ si zadarmo Redis databázu na console.upstash.com (bezplatný plán:
# 500 000 požiadaviek KAŽDÝ MESIAC) a doplň hodnoty zo záložky "REST API":
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Voliteľné: ak vyplníš oboje, appka bude vyžadovať prihlásenie (HTTP Basic Auth),
# aby ju nemohol používať hocikto s odkazom a nevyčerpal denný/minútový limit.
APP_USER=
APP_PASSWORD=

# Voliteľné: ak vyplníš oboje, každý uložený tip (aj tiket) sa automaticky
# pošle ako správa do tvojho Telegram kanálu/skupiny. Návod na získanie
# týchto hodnôt je v návode od Claude.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Voliteľné, Render.com si port nastavuje sám automaticky.
PORT=3000
